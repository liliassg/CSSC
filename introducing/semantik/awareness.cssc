#heap[int, 8] c = 1;

while (true) {
    #capacity[c] ccap;
    #size[c] csize;
    #stack[int, 8] l = 1;
    #size[l] sl;
    if ((ccap - csize) - sl <= 0) {
        #resize[c, 2];
        cssc::outln(csize);
    }
    c = c + l;
    #delete[l];
}

#define(kaka) {
    #stack[int, 32] var;
    return &var;
}

